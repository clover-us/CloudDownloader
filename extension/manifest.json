{
  "manifest_version": 3,
  "name": "CloudDownloader 接力",
  "version": "0.1.0",
  "description": "把浏览器下载交给 CloudDownloader：保留 Cookie、来源页面和浏览器标识。",
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "CloudDownloader 接力" }
}